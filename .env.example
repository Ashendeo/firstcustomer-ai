# Local demo: no API credentials needed
DATABASE_URL=sqlite:///./firstcustomer.db
DEMO_MODE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# In live mode, set these (costs can apply)
CRUSTDATA_API_KEY=
QWEN_MODEL=qwen3:4b
QWEN_MODEL_SERVER=http://localhost:11434/v1
# Bound each Ollama inference call; Qwen3 JSON does not use thinking
QWEN_TIMEOUT_SECONDS=120
QWEN_NUM_PREDICT=900
# Crustdata hybrid search understands natural language without Qwen planning
QWEN_PLAN_WITH_MODEL=false
MAX_COMPANIES=5
MAX_PEOPLE_SEARCHES=3
# Optional real email sending, one lead at a time after approval
RESEND_API_KEY=
FROM_EMAIL=
# Optional real Calendly webhook signing key (and subscription)
CALENDLY_SIGNING_KEY=
# HTTPS origin for public deployment (for link generation)
PUBLIC_BASE_URL=http://localhost:8000
