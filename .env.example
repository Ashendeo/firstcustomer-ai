# Local demo: no API credentials needed
DATABASE_URL=sqlite:///./firstcustomer.db
DEMO_MODE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# In live mode, set these (costs can apply)
CRUSTDATA_API_KEY=
QWEN_MODEL=qwen3:4b
QWEN_MODEL_SERVER=http://localhost:11434/v1
# Bound each Ollama inference call; Qwen3 JSON does not use thinking
QWEN_TIMEOUT_SECONDS=120
QWEN_NUM_PREDICT=900
# Crustdata hybrid search understands natural language without Qwen planning
QWEN_PLAN_WITH_MODEL=false
MAX_COMPANIES=5
MAX_PEOPLE_SEARCHES=3
# Optional real email sending, one lead at a time after approval
RESEND_API_KEY=
# Resend webhook signature secret: whsec_...
RESEND_WEBHOOK_SECRET=
# Optional long random secret (>=24 chars) for POST /outreach/tick
OUTREACH_CRON_SECRET=
FROM_EMAIL=
# Optional real Calendly webhook signing key (and subscription)
CALENDLY_SIGNING_KEY=
# HTTPS origin for public deployment (for link generation)
PUBLIC_BASE_URL=http://localhost:8000

# Optional private Gmail sink for demo messages. BOTH addresses must be your Gmail.
# Do not paste your normal Google password; create a separate Gmail App Password.
GMAIL_DEMO_SENDER=
GMAIL_DEMO_TO=
GMAIL_DEMO_APP_PASSWORD=

# Seller-company web research (Brave Search API); without it, web evidence is unavailable.
BRAVE_SEARCH_API_KEY=

# Maximum paid company-enrichment calls for sparse prospect profiles (default 2); set 0 to disable.
MAX_PROSPECT_ENRICHMENTS=2

# Rich prospect signals include taxonomy, hiring, funding, revenue, news.
# Each company enrich request may be billed. Premium technographics excluded.
MAX_PROSPECT_ENRICHMENTS=5
# Number of paid business-email enrichments attempted per campaign.
MAX_CONTACT_ENRICHMENTS=5
